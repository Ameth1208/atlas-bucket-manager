# ── API Server ────────────────────────────────────────────────
PORT=3001
JWT_SECRET=atlas-secret-change-me
CORS_ORIGIN=http://localhost:3000

# Database (relative to apps/api/ when running locally)
DB_PATH=./data

# Provider credentials (MinIO, AWS S3, R2, etc.) are NOT set here.
# They are managed through the Atlas web UI and stored in SQLite.
# Add providers after the first login via the "Connect Provider" modal.
