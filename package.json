{
  "name": "atlas-bucket-manager",
  "version": "1.0.2",
  "private": true,
  "description": "Multi-Cloud Storage Manager for Buckets (MinIO & S3).",
  "author": "Ameth Galarcio <https://amethgm.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameth1208/atlas-bucket-manager.git"
  },
  "bugs": {
    "url": "https://github.com/ameth1208/atlas-bucket-manager/issues"
  },
  "homepage": "https://github.com/ameth1208/atlas-bucket-manager#readme",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "dev:api": "pnpm --filter @atlas/api run dev",
    "dev:client": "pnpm --filter @atlas/client run dev",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter @atlas/api run build",
    "build:client": "pnpm --filter @atlas/client run build",
    "start": "pnpm --filter @atlas/api run start",
    "test": "pnpm -r run test",
    "test:api": "pnpm --filter @atlas/api run test",
    "test:client": "pnpm --filter @atlas/client run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r exec rm -rf dist .next node_modules/.cache"
  },
  "keywords": [
    "s3",
    "minio",
    "bucket",
    "manager",
    "storage",
    "multi-cloud",
    "aws",
    "monorepo"
  ]
}
