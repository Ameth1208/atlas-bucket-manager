{
  "name": "atlas-bucket-manager",
  "version": "2.0.5",
  "private": true,
  "description": "Multi-Cloud Storage Manager for Buckets (MinIO & S3).",
  "author": "Ameth Galarcio <https://amethgm.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameth1208/atlas-bucket-manager.git"
  },
  "bugs": {
    "url": "https://github.com/ameth1208/atlas-bucket-manager/issues"
  },
  "homepage": "https://github.com/ameth1208/atlas-bucket-manager#readme",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "cd apps/api && go run ./cmd/server",
    "dev:client": "pnpm --filter @atlas/client run dev",
    "build": "pnpm run build:api && pnpm run build:client",
    "build:api": "cd apps/api && go build -o atlas-api ./cmd/server",
    "build:client": "pnpm --filter @atlas/client run build",
    "start": "node docker-entrypoint.js",
    "test": "pnpm run test:api",
    "test:api": "cd apps/api && go test -v ./...",
    "test:client": "pnpm --filter @atlas/client run test",
    "lint": "pnpm --filter @atlas/client run lint",
    "typecheck": "pnpm --filter @atlas/client run typecheck",
    "clean": "rm -rf .next node_modules/.cache",
    "doctor": "npx react-doctor@latest"
  },
  "keywords": [
    "s3",
    "minio",
    "bucket",
    "manager",
    "storage",
    "multi-cloud",
    "aws",
    "monorepo"
  ]
}
